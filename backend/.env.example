# Copie para .env e ajuste conforme o ambiente.
# Deixe em branco / não defina para usar SQLite local (barbearia.db).
# Exemplo PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/barbearia
DATABASE_URL=

# ---------- Segurança ----------
# Chave para assinar os tokens (JWT). OBRIGATÓRIA em produção (Postgres): sem ela
# o sistema não sobe. Gere uma forte, ex.:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Origens liberadas para chamadas de navegador (CORS). Separe por vírgula.
# Em branco = usa APP_BASE_URL + localhost de desenvolvimento.
CORS_ORIGINS=

# Tamanho máximo do corpo das requisições, em bytes (padrão 1000000 = 1 MB).
MAX_BODY_BYTES=

# Chave do painel de administrador (/painel e /admin/*).
SUPERADMIN_KEY=
